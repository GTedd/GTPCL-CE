<local:MyPageRight x:Class="PCL.PageInstanceHorizonMods"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:local="clr-namespace:PCL"
                   xmlns:loc="https://ce.pclc.cc/core/localization"
                   mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Hidden">
        <Grid>
        <!-- 浏览 Horizon 注册表 -->
        <StackPanel x:Name="PanBrowse" Margin="25,25,25,10" Visibility="Collapsed">
            <local:MyCard Title="{loc:Loc Instance.Horizon.Browser.Title}" Margin="0,0,0,15">
                <StackPanel Margin="25,40,23,15">
                    <local:MySearchBox x:Name="BrowseSearch" Margin="0,0,0,10" SearchButtonVisibility="Visible"
                                       HintText="{loc:Loc Instance.Horizon.Browser.SearchHint}" Search="BrowseSearch_Search" />
                    <WrapPanel>
                        <local:MyComboBox x:Name="BrowseKind" Width="140" Height="35" Margin="0,0,12,8"
                                          SelectionChanged="BrowseFilter_Changed" />
                        <local:MyComboBox x:Name="BrowseSort" Width="140" Height="35" Margin="0,0,12,8"
                                          SelectionChanged="BrowseFilter_Changed" />
                        <local:MyButton MinWidth="110" Height="35" Padding="13,0" Margin="0,0,12,8"
                                        Text="{loc:Loc Instance.Horizon.Browser.Back}" Click="BrowseBack_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="LabBrowseStatus" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardBrowseResults" Title="{loc:Loc Instance.Horizon.Browser.Results}" Margin="0,0,0,15">
                <StackPanel x:Name="PanBrowseResults" Margin="12,38,12,12" />
            </local:MyCard>
        </StackPanel>

        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <!-- 操作 -->
            <local:MyCard Title="{loc:Loc Instance.Horizon.Mods.Title}" Margin="0,0,0,15">
                <StackPanel Margin="25,40,23,15">
                    <TextBlock x:Name="LabSupport" TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource ColorBrushGray3}" />
                    <WrapPanel>
                        <local:MyButton x:Name="BtnInstall" MinWidth="130" Height="35" Padding="13,0" Margin="0,0,12,8"
                                        ColorType="Highlight" Text="{loc:Loc Instance.Horizon.Mods.InstallFile}"
                                        Click="BtnInstall_Click" />
                        <local:MyButton x:Name="BtnBrowse" MinWidth="130" Height="35" Padding="13,0" Margin="0,0,12,8"
                                        Text="{loc:Loc Instance.Horizon.Mods.Browse}" Click="BtnBrowse_Click" />
                        <local:MyButton MinWidth="130" Height="35" Padding="13,0" Margin="0,0,12,8"
                                        Text="{loc:Loc Instance.Horizon.Mods.OpenContentFolder}" Click="BtnOpenContent_Click" />
                        <local:MyButton MinWidth="130" Height="35" Padding="13,0" Margin="0,0,12,8"
                                        Text="{loc:Loc Instance.Horizon.Mods.OpenNativeFolder}" Click="BtnOpenNative_Click" />
                        <local:MyButton MinWidth="100" Height="35" Padding="13,0" Margin="0,0,12,8"
                                        Text="{loc:Loc Instance.Horizon.Mods.Refresh}" Click="BtnRefresh_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <!-- 原生构建 -->
            <local:MyCard x:Name="CardNativeBuild" Title="{loc:Loc Instance.Horizon.Native.Title}" Margin="0,0,0,15">
                <StackPanel x:Name="PanNativeBuild" Margin="25,40,23,15" />
            </local:MyCard>

            <!-- 内容模组 -->
            <local:MyCard x:Name="CardContent" Title="{loc:Loc Instance.Horizon.Mods.Content}" Margin="0,0,0,15">
                <StackPanel Margin="12,38,12,12">
                    <TextBlock x:Name="LabContentEmpty" Margin="13,0,13,4" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Text="{loc:Loc Instance.Horizon.Mods.ContentEmpty}" />
                    <StackPanel x:Name="PanContentMods" />
                </StackPanel>
            </local:MyCard>

            <!-- 原生模组 -->
            <local:MyCard x:Name="CardNative" Title="{loc:Loc Instance.Horizon.Mods.Native}" Margin="0,0,0,15">
                <StackPanel Margin="12,38,12,12">
                    <TextBlock x:Name="LabNativeEmpty" Margin="13,0,13,4" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray3}"
                               Text="{loc:Loc Instance.Horizon.Mods.NativeEmpty}" />
                    <StackPanel x:Name="PanNativeMods" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>
